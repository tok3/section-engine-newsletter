{
    "name": "tok3/section-engine-newsletter",
    "description": "Newsletter signup collection and double opt-in for Section Engine.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.90",
        "tok3/section-engine": "^1.3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Tok3\\SectionEngineNewsletter\\": "src/",
            "Tok3\\SectionEngineNewsletter\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tok3\\SectionEngineNewsletter\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:tok3/section-engine.git"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Tok3\\SectionEngineNewsletter\\SectionEngineNewsletterServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": false,
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.git",
            "/.github",
            "/.superpowers",
            "/build",
            "/node_modules",
            "/vendor",
            "/docs/superpowers",
            "/AGENTS.md"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "format:check": "pint --test",
        "analyse": "phpstan analyse"
    }
}
